# Copy to .env, then export in Bash: set -a; source .env; set +a
# Used by review and trace repair; inference uses a local model.
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
OPENAI_API_KEY=
TGPO_LLM_MODEL=AHAT-TGPO
TGPO_LLM_SEED=7

# Build via scripts/setup_fast_downward.sh or use an existing installation.
FAST_DOWNWARD_PATH=/absolute/path/to/fast-downward/fast-downward.py

# Training paths; see recipe/tgpo/README.md.
# TGPO_MODEL=/absolute/path/to/base_model
# TGPO_TRAIN_DATA=/absolute/path/to/train.parquet
# TGPO_VAL_DATA=/absolute/path/to/validation.parquet
# TGPO_OUTPUT=outputs/tgpo
